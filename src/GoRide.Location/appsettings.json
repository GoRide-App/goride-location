{
  "Db": {
    "Host": "${env.DB_HOST}",
    "Port": "${env.DB_PORT}",
    "Database": "${env.DB_DATABASE}",
    "User": "${env.DB_USER}",
    "SslMode": "Required"
  },
  "Cors": {
    "AllowedOrigins": [
      "${env.FRONTEND_URL_LOCAL}",
      "${env.FRONTEND_URL_PROD}"
    ]
  },
  "Ors": {
    "BaseUrl": "https://api.openrouteservice.org"
  },
  "ServiceableArea": {
    "MinLat": 6.73,
    "MaxLat": 7.10,
    "MinLng": 79.79,
    "MaxLng": 80.16
  },
  "Fare": {
    "BaseFare": 40.0,
    "RatePerKm": 13.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}